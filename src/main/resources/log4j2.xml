<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" monitorInterval="30">
    <Appenders>
        <Console name="ConsoleAppender" target="SYSTEM_OUT" follow="true">
            <JsonLayout complete="false"
                        compact="true"
                        eventEol="true"
                        properties="true"
                        objectMessageAsJsonObject="true"
                        locationInfo="true" />
        </Console>
    </Appenders>

    <Loggers>
        <Logger name="org.springframework.web.bind.MethodArgumentNotValidException" level="warn" additivity="false">
            <AppenderRef ref="ConsoleAppender" />
        </Logger>

        <Logger name="software.amazon.awssdk" level="warn" additivity="false">
            <AppenderRef ref="ConsoleAppender" />
        </Logger>

        <Root level="info">
            <AppenderRef ref="ConsoleAppender" />
        </Root>
    </Loggers>
</Configuration>